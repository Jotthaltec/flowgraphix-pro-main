SUPABASE_PUBLISHABLE_KEY="sua-chave-supabase-anon"
SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_PROJECT_ID="seu-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-supabase-anon"
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
ANTHROPIC_API_KEY="sk-ant-api03-..."

# Chave de serviço, usada pela API da integração para gravar ignorando o RLS.
# Nunca prefixe com VITE_: isso a exporia no bundle do navegador.
SUPABASE_SERVICE_ROLE_KEY=""

# -----------------------------------------------------------------------------
# Integração com a loja Nexus Printi
#
# Duas chaves, uma por direção. Mantenha-as diferentes: assim vazar uma não
# entrega as duas pontas.
# -----------------------------------------------------------------------------

# Chave que o Nexus envia ao chamar /api/v1/* daqui (entrada). Mínimo 24
# caracteres. Precisa ser igual a FLOWPRINTI_API_KEY no Nexus.
# Gere com: openssl rand -hex 32
NEXUS_API_KEY=""

# Webhook do Nexus para onde os eventos daqui são entregues (saída).
NEXUS_WEBHOOK_URL="https://sualoja.com.br/api/integrations/flowprinti/webhook"

# Chave enviada nesse webhook. Precisa ser igual a FLOWPRINTI_WEBHOOK_KEY no Nexus.
NEXUS_WEBHOOK_KEY=""
